{
  "info": {
    "name": "Scatto - Progetto settimana 16",
    "description": "Tutte le API del backend Scatto. Ordine consigliato: 1. Autenticazione (Registrazione salva token ed email nell'environment), poi 2. Post, 3. Documenti OCR, 4. Geocoding, 5. Errori. I file dei form multipart sono in backend/postman/files: in Postman imposta Settings > General > Working directory sulla cartella backend/postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Autenticazione",
      "item": [
        {
          "name": "Registrazione (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Credenziali nuove a ogni esecuzione: niente 409 se la ripeti",
                  "const ts = Date.now().toString().slice(-8);",
                  "pm.environment.set('username', `postman_${ts}`);",
                  "pm.environment.set('email', `postman${ts}@example.com`);",
                  "pm.environment.set('password', 'Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Risposta con token e utente', () => { pm.expect(body.token).to.be.a('string'); pm.expect(body.user.username).to.eql(pm.environment.get('username')); });",
                  "pm.environment.set('token', body.token);",
                  "pm.environment.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Login (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('token', body.token);",
                  "pm.environment.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Utente corrente (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('È l\\'utente del token', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('userId'))));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/me" },
          "response": []
        },
        {
          "name": "Registrazione con dati non validi (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Errori di validazione in details', () => pm.expect(pm.response.json().details).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ab\",\n  \"email\": \"non-una-email\",\n  \"password\": \"corta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Registrazione duplicata (409)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Login con password errata (401)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password-sbagliata\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Post",
      "item": [
        {
          "name": "Crea post UPLOAD con 2 foto e posizione (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const post = pm.response.json();",
                  "pm.test('2 foto, origine UPLOAD, posizione sul post', () => {",
                  "  pm.expect(post.photos).to.have.lengthOf(2);",
                  "  pm.expect(post.photoSource).to.eql('UPLOAD');",
                  "  pm.expect(post.location.address).to.include('Colosseo');",
                  "});",
                  "pm.environment.set('postId', post.id);",
                  "pm.environment.set('photoUrl', post.photos[0].url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "source", "value": "UPLOAD", "type": "text" },
                { "key": "photos", "type": "file", "src": "files/foto-1.jpg" },
                { "key": "photos", "type": "file", "src": "files/foto-2.jpg" },
                { "key": "caption", "value": "Post creato da Postman", "type": "text" },
                { "key": "latitude", "value": "41.8902", "type": "text" },
                { "key": "longitude", "value": "12.4922", "type": "text" },
                { "key": "address", "value": "Colosseo, Piazza del Colosseo, Roma", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "response": []
        },
        {
          "name": "Crea post CAMERA con 1 foto (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Origine CAMERA, 1 foto, senza posizione', () => { const p = pm.response.json(); pm.expect(p.photoSource).to.eql('CAMERA'); pm.expect(p.photos).to.have.lengthOf(1); pm.expect(p.location).to.eql(null); });",
                  "pm.environment.set('cameraPostId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "source", "value": "CAMERA", "type": "text" },
                { "key": "photos", "type": "file", "src": "files/foto-1.jpg" },
                { "key": "caption", "value": "Scatto dalla fotocamera", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "response": []
        },
        {
          "name": "CAMERA con 2 foto (400)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "source", "value": "CAMERA", "type": "text" },
                { "key": "photos", "type": "file", "src": "files/foto-1.jpg" },
                { "key": "photos", "type": "file", "src": "files/foto-2.jpg" }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "response": []
        },
        {
          "name": "Foto con formato falso (415)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));",
                  "pm.test('Messaggio con i formati ammessi', () => pm.expect(pm.response.json().message).to.include('JPEG'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "source", "value": "UPLOAD", "type": "text" },
                { "key": "photos", "type": "file", "src": "files/foto-falsa.jpg" }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "response": []
        },
        {
          "name": "Indirizzo senza coordinate (400)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "source", "value": "UPLOAD", "type": "text" },
                { "key": "photos", "type": "file", "src": "files/foto-1.jpg" },
                { "key": "address", "value": "Roma", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "response": []
        },
        {
          "name": "Feed paginato (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Formato della pagina', () => pm.expect(pm.response.json()).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/posts?page=0&size=10" },
          "response": []
        },
        {
          "name": "Dettaglio del post (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/posts/{{postId}}" },
          "response": []
        },
        {
          "name": "Post di un utente (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}/posts?page=0&size=10" },
          "response": []
        },
        {
          "name": "Foto pubblica, senza token (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('È un\\'immagine', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//));"
                ]
              }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}{{photoUrl}}" },
          "response": []
        },
        {
          "name": "Elimina il post (204)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/posts/{{postId}}" },
          "response": []
        },
        {
          "name": "Elimina il post CAMERA (204)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/posts/{{cameraPostId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "3. Documenti OCR",
      "item": [
        {
          "name": "Carica documento PDF (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const doc = pm.response.json();",
                  "pm.test('OCR avviato in stato PENDING', () => pm.expect(doc.ocrStatus).to.eql('PENDING'));",
                  "pm.environment.set('documentId', doc.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "files/documento-ocr.pdf" }]
            },
            "url": "{{baseUrl}}/api/users/me/documents"
          },
          "response": []
        },
        {
          "name": "I miei documenti (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/me/documents" },
          "response": []
        },
        {
          "name": "Stato OCR e testo estratto (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const doc = pm.response.json();",
                  "console.log('Stato OCR:', doc.ocrStatus);",
                  "pm.test('OCR completato (se è PENDING o PROCESSING aspetta 2 secondi e rimanda)', () => pm.expect(doc.ocrStatus).to.eql('COMPLETED'));",
                  "pm.test('Testo estratto presente', () => pm.expect(doc.extractedText).to.include('Totale'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/me/documents/{{documentId}}" },
          "response": []
        },
        {
          "name": "Download del file originale (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('È un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/me/documents/{{documentId}}/file" },
          "response": []
        },
        {
          "name": "Documento con formato falso (415)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "files/foto-falsa.jpg" }]
            },
            "url": "{{baseUrl}}/api/users/me/documents"
          },
          "response": []
        },
        {
          "name": "Elimina il documento (204)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/users/me/documents/{{documentId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "4. Geocoding",
      "item": [
        {
          "name": "Indirizzo -> coordinate (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Al massimo 5 risultati con coordinate', () => { const r = pm.response.json(); pm.expect(r.length).to.be.within(1, 5); pm.expect(r[0]).to.include.keys('displayName', 'latitude', 'longitude'); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/geocoding/search?q=Colosseo%20Roma" },
          "response": []
        },
        {
          "name": "Coordinate -> indirizzo (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/geocoding/reverse?lat=41.8902&lon=12.4922" },
          "response": []
        },
        {
          "name": "Ricerca troppo corta (400)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/geocoding/search?q=ab" },
          "response": []
        }
      ]
    },
