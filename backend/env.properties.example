# Copia questo file in "env.properties" (stessa cartella) e inserisci i tuoi valori.
# env.properties e' ignorato da git: non contiene mai segreti versionati.
DB_URL=jdbc:postgresql://localhost:5432/social_network
DB_USERNAME=postgres
DB_PASSWORD=la_tua_password
# Almeno 32 caratteri casuali (HMAC-SHA256)
JWT_SECRET=sostituisci_con_una_stringa_casuale_di_almeno_32_caratteri
TESSDATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
